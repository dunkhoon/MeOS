# Secrets / local env
.env
.env.local
.env.*.local
.secrets/

# Dependencies
node_modules/

# Build output
dist/
build/
out/
web/dev-dist/
dist-desktop/

# 앱 아이콘은 생성물이지만 커밋한다 — 없으면 electron-builder 가 조용히 기본 아이콘을 쓴다
!electron/build/
!electron/build/icon.ico

# OpenClaw 플러그인 빌드 결과도 커밋한다 — `openclaw plugins install` 은 .ts 를 빌드하지 않고
# 폴더를 그대로 복사한다. dist 가 없으면 설치가 거절되고, 낡은 dist 가 있으면 그게 그대로
# 깔린다(고친 게 조용히 무시됨). 설치하는 PC 에 빌드 도구를 두지 않으려고 결과를 함께 둔다.
!openclaw/plugins/*/dist/
!openclaw/plugins/*/dist/**

# 도구 상태 (세션·비용 기록 등 — 저장소에 들어갈 이유 없음)
.omc/

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# Edge Function 시크릿 (supabase secrets set --env-file 용, .env.local 에서 복사됨)
supabase/.env.secrets

# Supabase CLI 로컬 상태 (link 하면 생김)
supabase/.temp/

# Garmin 토큰 (러닝화 정보용, 갱신 토큰 포함 — 절대 커밋 금지)
garmin-tokens.json

# 서브셋 생성 중간 산물
scripts/.font-chars.txt

# OpenClaw 플러그인 검증용 SDK 사본 (저장소에 넣지 않는다)
openclaw/plugins/*/node_modules/
