# Secrets / local env
.env
.env.local
.env.*.local
.secrets/

# Dependencies
node_modules/

# Build output
dist/
build/
out/
web/dev-dist/
dist-desktop/

# 앱 아이콘은 생성물이지만 커밋한다 — 없으면 electron-builder 가 조용히 기본 아이콘을 쓴다
!electron/build/
!electron/build/icon.ico

# 도구 상태 (세션·비용 기록 등 — 저장소에 들어갈 이유 없음)
.omc/

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# Edge Function 시크릿 (supabase secrets set --env-file 용, .env.local 에서 복사됨)
supabase/.env.secrets

# Supabase CLI 로컬 상태 (link 하면 생김)
supabase/.temp/

# Garmin 토큰 (러닝화 정보용, 갱신 토큰 포함 — 절대 커밋 금지)
garmin-tokens.json

# 서브셋 생성 중간 산물
scripts/.font-chars.txt

# OpenClaw 플러그인 검증용 SDK 사본 (저장소에 넣지 않는다)
openclaw/plugins/*/node_modules/
