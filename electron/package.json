{
  "name": "@pp/desktop",
  "private": true,
  "version": "0.1.0",
  "description": "MeOS 데스크톱 셸 (+ 회사 업무 실시간 조회 담당)",
  "main": "main.js",
  "author": "dunkhoon",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "games.aquatree.meos",
    "productName": "MeOS",
    "directories": {
      "output": "../dist-desktop",
      "buildResources": "build"
    },
    "npmRebuild": false,
    "files": ["main.js", "preload.js", "shell.html", "bts.js", "p4.js", "llm.js", "app-icon.png", "tray-icon.png"],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "MeOS",
      "artifactName": "MeOS-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "MeOS-${version}-portable.${ext}"
    },
    "protocols": [
      {
        "name": "MeOS",
        "schemes": ["privateplanner"]
      }
    ]
  }
}
