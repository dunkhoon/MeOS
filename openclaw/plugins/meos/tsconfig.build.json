{
  // `npm run build` 용 — 타입 검사만 하는 tsconfig.json 에 "내보내기" 만 얹는다.
  //
  // ⚠️ `openclaw plugins install` 은 **TypeScript 를 빌드하지 않는다.** 폴더를 그대로 복사할 뿐이라
  //    컴파일된 `dist/index.js` 가 없으면 설치가 아예 거절된다
  //    ("package install requires compiled runtime output for TypeScript entry ./index.ts").
  //    그래서 `dist/` 를 저장소에 함께 커밋한다 — 설치하는 PC 에 빌드 도구가 없어도 되게.
  //    **소스를 고치면 반드시 `npm run build` 를 돌려 dist 도 같이 커밋한다.**
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "./dist",
    "rootDir": ".",
    "declaration": false,
    "sourceMap": false,
    // 타입 검사는 하지 않고 **내보내기만** 한다.
    // 이 폴더에는 `openclaw`·`@types/node` 가 설치돼 있지 않아(설치기가 peerDependency 를
    // 링크해 주는 구조라 개발 PC 에는 없다) 타입 해석이 실패한다. 그 실패로 빌드가 멈추면
    // pre-commit 훅이 매번 막혀 결국 훅을 끄게 되고, 그러면 낡은 dist 사고가 그대로 돌아온다.
    // 산출물은 타입 검사 여부와 무관하게 같다(실측: 두 결과가 바이트 단위로 동일).
    // 진짜 타입 검사는 실제 SDK 를 설치한 자리에서 따로 한다.
    "noCheck": true
  },
  "include": ["index.ts", "setup-entry.ts", "src/**/*.ts"]
}
